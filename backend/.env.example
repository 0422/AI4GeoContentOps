# 2026-10-23：本次修改原因：提供不含真实密钥的后端本机配置模板。
DEEPSEEK_API_KEY=

# 2026-10-23：本次修改原因：为公众号样本采集验证配置 RedFox API 密钥；只填写到本机 .env。
REDFOX_API_KEY=

# 2026-10-23：本次修改原因：公众号取文可选用已安装的 Edge，或打开浏览器窗口排查验证页。
# WECHAT_BROWSER_CHANNEL=msedge
# WECHAT_BROWSER_HEADLESS=false

# 2026-10-23：本次修改原因：保留兼容 Chat Completions 供应商的可选配置示例。
# CUSTOM_LLM_BASE_URL=https://example.com/v1
# CUSTOM_LLM_MODELS=example-model
# CUSTOM_LLM_API_KEY=

# 2026-10-23：本次修改原因：支持多个供应商分别引用各自的密钥变量。
# LLM_PROVIDERS_JSON='[{"provider":"example","base_url":"https://example.com/v1","api_key_env":"EXAMPLE_API_KEY","models":["example-model"]}]'
# EXAMPLE_API_KEY=
